{
    "name": "shetabit/chunky",
    "type": "library",
    "description": "resumable chunk upload manager",
    "keywords": [
        "upload manager",
        "upload-manager",
        "chunk upload",
        "chunk resumable upload",
        "php resume chunk upload",
        "resume upload"
    ],
    "homepage": "https://github.com/shetabit/chunky",
    "license": "MIT",
    "authors": [
        {
            "name": "Mahdi Khanzadi",
            "email": "khanzadimahdi@gmail.com",
            "homepage": "https://github.com/khanzadimahdi",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpcsstandards/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Shetabit\\Chunky\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shetabit\\Chunky\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "check-style": "phpcs",
        "fix-style": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G",
        "rector": "rector process --dry-run",
        "ci": [
            "@check-style",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite.",
        "test-coverage": "Run the test suite and report code coverage.",
        "check-style": "Check the coding style of src and tests.",
        "fix-style": "Fix the coding style of src and tests where possible.",
        "analyse": "Run static analysis on src.",
        "rector": "Show the refactorings Rector would apply.",
        "ci": "Run every check the CI pipeline runs."
    },
    "config": {
        "sort-packages": true
    }
}
